# Copy this file to .env and fill both password values.
# Never commit the resulting .env file.
MYSQL_DATABASE=kbo_predictor
DB_USERNAME=kbo_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=8080
FRONTEND_PORT=3000
SESSION_TIMEOUT=2h
# localhost HTTP 검증용입니다. 실제 HTTPS 배포에서는 반드시 true로 변경합니다.
SESSION_COOKIE_SECURE=false
